# Twitch source (a channel URL for live, or a VOD URL)
TWITCH_URL=https://www.twitch.tv/your_channel
SOURCE_KIND=live
TWITCH_QUALITY=best
SAMPLE_FPS=2
PLAYER_GAMERTAG=your_exact_apex_name
OCR_MIN_CONFIDENCE=0.40
OCR_FUZZY_MATCH_THRESHOLD=0.88
OCR_SINGLE_FRAME_SIMILARITY=0.94
GAMERTAG_MATCH_THRESHOLD=0.82
# ROI format: x,y,width,height for a 1920x1080 frame.
NOTIFICATION_ROI=500,700,1000,180
KILLFEED_ROI=1150,110,730,230
# A sampled ROI reaches OCR only when at least this fraction of pixels changed.
OCR_MOTION_THRESHOLD=0.008
OCR_MOTION_PIXEL_THRESHOLD=18
OCR_MOTION_SIZE=160
# OCR preprocessing and freshness-first keyframe queue.
OCR_MAX_IMAGE_WIDTH=720
OCR_BINARY_THRESHOLD=120
OCR_CONFIRMATION_FRAMES=2
OCR_CANDIDATE_MAX_GAP_SECONDS=2
OCR_KEYFRAME_INTERVAL_SECONDS=1
OCR_QUEUE_SIZE=1
# Skip stale live keyframes rather than letting slow OCR drift behind the stream.
OCR_MAX_LIVE_LAG_SECONDS=3
# Do not suppress detections globally. The event queue deduplicates and groups them.
EVENT_COOLDOWN_SECONDS=0
EVENT_MERGE_GAP_SECONDS=50
EVENT_DUPLICATE_WINDOW_SECONDS=8
# Default events: 20 seconds before and 5 seconds after detection.
PRE_EVENT_SECONDS=20
POST_EVENT_SECONDS=5
# BLEEDOUT appears near the end of a fight, so keep more history for it.
BLEEDOUT_PRE_EVENT_SECONDS=25
BLEEDOUT_POST_EVENT_SECONDS=5
# Compressed live buffer and encoder budget for jobs running beside EasyOCR.
BUFFER_SECONDS=120
FFMPEG_ENCODING_THREADS=2
FFMPEG_MAX_CONCURRENT_ENCODES=1
FFMPEG_LOW_PRIORITY=true
# Values: auto, h264_amf (AMD), h264_qsv (Intel), h264_nvenc (NVIDIA), libx264 (CPU).
FFMPEG_SOURCE_ENCODER=libx264
# Lower values retain more detail. Hardware encoders are tested before use and
# fall back to libx264 if their driver becomes unavailable.
FFMPEG_SOURCE_QUALITY=14
FFMPEG_VERTICAL_ENCODER=auto
FFMPEG_VERTICAL_QUALITY=16
# Master at 1080x1920/60 FPS. Stay below Instagram's 25 Mbps API limit.
VERTICAL_VIDEO_TARGET_KBPS=18000
VERTICAL_VIDEO_MAX_KBPS=22000
# x,y,width,height within the 1920x1080 source. Wider means less enlargement.
GAMEPLAY_CROP=480,0,960,1080
FFMPEG_PREVIEW_ENCODER=auto
# For a VOD started from a non-zero time in FFmpeg/Streamlink:
VOD_START_OFFSET_SECONDS=0

# Telegram: chat ID must be your private numeric chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# EasyOCR is attempted first; Tesseract is the local fallback.
# Set false only when Tesseract is not installed.
TESSERACT_ENABLED=true
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# MySQL (the configured account needs CREATE DATABASE/TABLE on first run)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=apex_clipper
MYSQL_PASSWORD=
MYSQL_DATABASE=apex_clipper

# Keep upload traffic away from a live Twitch stream.
PAUSE_UPLOADS_WHILE_LIVE=true
UPLOAD_DELAY_SECONDS=5
UPLOAD_MAX_ATTEMPTS=3
UPLOAD_RETRY_BASE_SECONDS=10

# YouTube OAuth desktop client JSON and token cache
YOUTUBE_CLIENT_SECRETS=
YOUTUBE_TOKEN_FILE=youtube_token.json

# Instagram Graph API.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
META_GRAPH_API_VERSION=v23.0
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com
INSTAGRAM_PROCESSING_TIMEOUT_SECONDS=600
INSTAGRAM_POLL_INTERVAL_SECONDS=5

# Cloudflare R2 temporary storage. These four values are required for the
# automatic local-file -> HTTPS -> Instagram pipeline.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_KEY_PREFIX=clips
R2_PRESIGNED_URL_TTL_SECONDS=21600
R2_DELETE_AFTER_PUBLISH=true
# Optional: set a public R2 custom domain. Leave blank to use a signed GET URL.
R2_PUBLIC_BASE_URL=

# Legacy only: use this instead of R2 when another process already uploads the
# file to an existing CDN. It is ignored when all four R2 values are configured.
INSTAGRAM_VIDEO_URL_TEMPLATE=

# TikTok Content Posting Upload API. The OAuth token requires video.upload.
# The clip is delivered as an editable draft to the TikTok mobile inbox.
TIKTOK_ACCESS_TOKEN=
TIKTOK_STATUS_TIMEOUT_SECONDS=300
TIKTOK_STATUS_POLL_INTERVAL_SECONDS=3
# 5-64 MB; files up to 64 MB are uploaded as a single chunk automatically.
TIKTOK_CHUNK_SIZE_BYTES=10000000
